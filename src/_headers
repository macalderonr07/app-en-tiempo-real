# Cabeceras HTTP para Cloudflare Pages (este archivo no se sirve como página).
# CSP: solo se permite cargar código propio y el SDK de Firebase; conexiones solo a
# Firebase, al ruteo y a la búsqueda de OpenStreetMap. 'unsafe-inline' en estilos
# hace falta porque Leaflet posiciona el mapa con atributos style.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tile.openstreetmap.org; connect-src 'self' https://www.gstatic.com https://*.googleapis.com https://*.firebaseio.com https://routing.openstreetmap.de https://nominatim.openstreetmap.org https://tile.openstreetmap.org; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-src https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), screen-wake-lock=(self), payment=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
